{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LookupOrder",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:111122223333:table/orders"
      ]
    },
    {
      "Sid": "GetHelpArticle",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::acme-help-center/*"
      ]
    },
    {
      "Sid": "RequestRefund",
      "Effect": "Allow",
      "Action": [
        "sqs:SendMessage"
      ],
      "Resource": [
        "arn:aws:sqs:us-east-1:111122223333:refund-requests"
      ]
    }
  ]
}
